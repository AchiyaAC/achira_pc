PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# Vercel frontend URL. Multiple URLs can be comma-separated.
CLIENT_URLS=https://your-project.vercel.app,http://localhost:5173

# Google OAuth Web Client ID.
# IMPORTANT: use the SAME value in Render and Vercel.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Cloudinary - required for permanent product images on Render.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password
